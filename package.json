{
  "name": "fourth-wall",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-worker.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:fixtures": "node scripts/prepare-fixtures.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
